# Public canonical URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://autorev.id

# Digits only, including country code. Example format: 6281234567890
NEXT_PUBLIC_WHATSAPP_NUMBER=6281367408145

# Optional. Requests are still validated when no webhook is configured.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Optional analytics provider ID. No analytics script is loaded when empty.
NEXT_PUBLIC_ANALYTICS_ID=
